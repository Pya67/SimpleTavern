DATABASE_URL=postgres://tavern:tavern@localhost:5432/tavern
# Password hash (base64-wrapped argon2). Generate with: pnpm auth:hash "your password"
AUTH_PASSWORD_HASH=
# 32+ random characters used to sign the session cookie
AUTH_SECRET=change-me-to-a-long-random-string-please
# true = skip login entirely (dev/testing only)
AUTH_BYPASS=false
# Optional. Can also be set in Settings (stored encrypted).
OPENROUTER_API_KEY=
# true = use the built-in mock OpenRouter (no network, no cost)
OPENROUTER_MOCK=true
# Optional: override the OpenRouter API base URL (ignored in mock mode)
OPENROUTER_BASE_URL=
# Key for encrypting secrets stored in the DB (32+ chars)
ENCRYPTION_KEY=change-me-to-another-long-random-string
APP_URL=http://localhost:3000

TLS_CERT_FILE=
TLS_KEY_FILE=